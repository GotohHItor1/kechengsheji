<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.ExprMapper">

    <resultMap id="exprResultMap" type="com.example.pojo.Expr">
        <id property="id" column="id"/>
        <result property="empId" column="emp_id"/>
        <result property="begin" column="begin"/>
        <result property="end" column="end"/>
        <result property="company" column="company"/>
        <result property="job" column="job"/>
    </resultMap>

    <!-- 根据员工ID查询工作经历 (begin/end 是 MySQL 保留字，需反引号) -->
    <select id="getByEmpId" resultMap="exprResultMap">
        SELECT id, emp_id, `begin`, `end`, company, job
        FROM emp_expr
        WHERE emp_id = #{empId}
        ORDER BY `begin` DESC
    </select>

    <!-- 批量插入工作经历 -->
    <insert id="insertBatch">
        INSERT INTO emp_expr (emp_id, `begin`, `end`, company, job)
        VALUES
        <foreach collection="list" item="expr" separator=",">
            (#{expr.empId}, #{expr.begin}, #{expr.end}, #{expr.company}, #{expr.job})
        </foreach>
    </insert>

    <!-- 根据员工ID删除工作经历 -->
    <delete id="deleteByEmpId">
        DELETE FROM emp_expr WHERE emp_id = #{empId}
    </delete>

</mapper>
