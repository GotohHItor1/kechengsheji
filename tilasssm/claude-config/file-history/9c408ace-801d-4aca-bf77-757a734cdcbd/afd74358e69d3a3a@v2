<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.DeptMapper">

    <!-- 结果映射 -->
    <resultMap id="deptResultMap" type="com.example.pojo.Dept">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <!-- 查询所有部门 -->
    <select id="list" resultMap="deptResultMap">
        SELECT id, name, create_time, update_time
        FROM dept
        ORDER BY id
    </select>

    <!-- 根据ID查询部门 -->
    <select id="getById" resultMap="deptResultMap">
        SELECT id, name, create_time, update_time
        FROM dept
        WHERE id = #{id}
    </select>

    <!-- 新增部门 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO dept (name) VALUES (#{name})
    </insert>

    <!-- 删除部门 -->
    <delete id="deleteById">
        DELETE FROM dept WHERE id = #{id}
    </delete>

    <!-- 修改部门 -->
    <update id="update">
        UPDATE dept SET name = #{name} WHERE id = #{id}
    </update>

</mapper>
