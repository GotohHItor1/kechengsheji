<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.LogMapper">

    <resultMap id="logResultMap" type="com.example.pojo.OperateLog">
        <id property="id" column="id"/>
        <result property="operateEmp" column="operate_emp"/>
        <result property="operateTime" column="operate_time"/>
        <result property="className" column="class_name"/>
        <result property="methodName" column="method_name"/>
        <result property="methodParams" column="method_params"/>
        <result property="returnValue" column="return_value"/>
        <result property="costTime" column="cost_time"/>
    </resultMap>

    <!-- 新增操作日志 -->
    <insert id="insert">
        INSERT INTO operate_log (operate_emp, operate_time, class_name, method_name, method_params, return_value, cost_time)
        VALUES (#{operateEmp}, #{operateTime}, #{className}, #{methodName}, #{methodParams}, #{returnValue}, #{costTime})
    </insert>

    <!-- 分页查询操作日志 -->
    <select id="page" resultMap="logResultMap">
        SELECT id, operate_emp, operate_time, class_name, method_name, method_params, return_value, cost_time
        FROM operate_log
        ORDER BY operate_time DESC
    </select>

</mapper>
